# Copy to .env.local and adjust for your environment.

# URL of the running backend (Milestone 1 FastAPI server).
VITE_API_BASE_URL=http://localhost:8000

# Map tile style.
# Default: OpenFreeMap liberty style — completely free, no API key.
# https://openfreemap.org
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# Centre the map on Hays County, TX.
VITE_MAP_INITIAL_LNG=-97.9
VITE_MAP_INITIAL_LAT=30.05
VITE_MAP_INITIAL_ZOOM=10
