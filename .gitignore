# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Environment — .env.example IS committed, real .env files are not
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# ---------------------------------------------------------------------------
# Data — raw downloads and processed GeoParquet are large (~80 MB) and fully
# reproducible via `python -m app.scripts.ingest_*`.  Track the scripts, not the
# outputs.
# ---------------------------------------------------------------------------
data/raw/
data/processed/

